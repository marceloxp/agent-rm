{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/block-rm.sh",
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": ".cursor/hooks/block-delete.sh",
        "matcher": "Delete",
        "failClosed": true
      }
    ]
  }
}
